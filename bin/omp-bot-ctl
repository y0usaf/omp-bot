#!/bin/sh
set -eu
usage="usage: omp-bot-ctl restart BOT"
[ $# -eq 2 ] && [ "$1" = restart ] || { echo "$usage" >&2; exit 2; }
name=$2
case $name in
"" | .* | *[!A-Za-z0-9._\ -]*) echo "omp-bot: invalid bot name '$name'" >&2; exit 2 ;;
esac
config=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/env
[ ! -r "$config" ] || . "$config"
state=${OMP_BOT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omp-bot}
[ -r "$state/bots.json" ] || { echo "omp-bot-ctl: no roster at $state/bots.json" >&2; exit 1; }
jq -e --arg n "$name" 'any(.[]; .name == $n)' "$state/bots.json" >/dev/null || { echo "omp-bot-ctl: no bot named $name" >&2; exit 1; }
dir=$state/bots/$name
mkdir -p "$dir"
if flock -n "$dir/lock" true 2>/dev/null; then
	echo "$name is not open; nothing to restart"
	exit 0
fi
: >"$dir/restart"
echo "restarting $name once its turn ends"
