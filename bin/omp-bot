#!/bin/sh
set -eu
usage="usage: omp-bot NAME [--create TINT] [omp args...]"
[ $# -ge 1 ] || { echo "$usage" >&2; exit 2; }
root=$(cd -P "$(dirname "$0")/.." && pwd)
name=$1
shift
case $name in
"" | .* | *[!A-Za-z0-9._\ -]*) echo "omp-bot: invalid bot name '$name' (letters, digits, space, '.', '_' or '-', not starting with '.')" >&2; exit 2 ;;
esac
[ ${#name} -le 40 ] || { echo "omp-bot: bot name longer than 40 characters" >&2; exit 2; }
tint=
case ${1:-} in
--create) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; tint=$2; shift 2 ;;
esac
config=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/env
[ ! -r "$config" ] || . "$config"
state=${OMP_BOT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omp-bot}
mkdir -p "$state"
[ -e "$state/bots.json" ] || { cp "$root/bots.json" "$state/bots.json" && chmod 644 "$state/bots.json"; }
if [ -n "$tint" ]; then
	(
		flock 9
		jq -e --arg n "$name" 'any(.[]; .name == $n)' "$state/bots.json" >/dev/null && exit 0
		tmp=$(mktemp "$state/bots.json.XXXXXX")
		jq --arg n "$name" --arg t "$tint" '. + [{name: $n, tint: $t, cwd: "~"}]' "$state/bots.json" >"$tmp"
		chmod 644 "$tmp"
		mv -f "$tmp" "$state/bots.json"
	) 9>"$state/bots.lock"
fi
bot=$(jq -ce --arg n "$name" '.[] | select(.name == $n)' "$state/bots.json") || { echo "omp-bot: no bot named $name in $state/bots.json" >&2; exit 1; }
field() { printf '%s' "$bot" | jq -r --arg k "$1" '.[$k] // empty'; }
dir=$state/bots/$name
mkdir -p "$dir/sessions"
home() { case $1 in "~") printf '%s\n' "$HOME" ;; "~/"*) printf '%s\n' "$HOME/${1#"~/"}" ;; *) printf '%s\n' "$1" ;; esac; }
paths=$(printf '%s' "$bot" | jq -r '.persist // [] | .[]' | while IFS= read -r path; do
	path=$(home "$path")
	case $path in /*) printf '%s\n' "$path" ;; *) echo "omp-bot: $name's persist path '$path' is neither absolute nor under ~" >&2; exit 1 ;; esac
done) || exit 1
fresh=
if [ -n "$paths" ] && [ -n "${OMP_BOT_PERSIST:-}" ]; then
	fresh=$(printf '%s\n' "$paths" | while IFS= read -r path; do "$OMP_BOT_PERSIST" mount "$path" || exit 1; done) || { echo "omp-bot: $OMP_BOT_PERSIST could not persist $name's paths" >&2; exit 1; }
fi
cwd=$(home "$(field cwd)")
omp=${OMP_BIN:-omp}
if [ "$(field box)" = true ]; then
	box=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/box.env
	[ ! -r "$box" ] || . "$box"
	export OMP_BOT_BOX_CWD="${cwd:-$HOME}" OMP_BOT_PERSIST_PATHS="$paths" OMP_BOT_PERSIST_FRESH="$fresh"
	omp=$root/bin/omp-bot-box boxed=1
	cd "$HOME"
else
	cd "${cwd:-$HOME}"
fi
export OMP_BOT_NAME="$name" OMP_BOT_TINT="$(field tint)" OMP_BOT_STATE="$state" PI_NO_TITLE=1 PI_NOTIFICATIONS=off
export PATH="$root/tools/$name/bin:$PATH"
[ -z "${OMP_BOT_EXTENSION:-}" ] || set -- -e "$OMP_BOT_EXTENSION" "$@"
[ -z "${OMP_BOT_CWD_EXTENSION:-}" ] || set -- -e "$OMP_BOT_CWD_EXTENSION" "$@"
[ -z "${OMP_BOT_SECRETS_EXTENSION:-}" ] || set -- -e "$OMP_BOT_SECRETS_EXTENSION" "$@"
[ -z "${OMP_BOT_WORK_FOLD_EXTENSION:-}" ] || set -- -e "$OMP_BOT_WORK_FOLD_EXTENSION" "$@"
[ -z "${OMP_BOT_CHAT_LOOK_EXTENSION:-}" ] || set -- -e "$OMP_BOT_CHAT_LOOK_EXTENSION" "$@"
[ "${OMP_BOT_NO_TOOLS:-}" != 1 ] || set -- --no-tools "$@"
[ "$(field extensions)" = true ] || set -- --no-extensions "$@"
[ "$(field work)" != true ] || set -- -e "$root/omp/work.ts" "$@"
model=$(field model)
model=${model:-${OMP_BOT_MODEL:-}}
[ -z "$model" ] || set -- --model "$model" "$@"
export OMP_BOT_HELPER_MODEL="$model"
[ ! -f "$dir/config.yml" ] || set -- --config "$dir/config.yml" "$@"
post() {
	while sleep 1; do
		for out in "$dir/outbox"/*/; do
			set -- "$out"*.json
			[ -e "$1" ] || continue
			to=${out%/}
			to=${to##*/}
			if jq -e --arg n "$to" 'any(.[]; .name == $n)' "$state/bots.json" >/dev/null; then
				:
			else
				[ $? -eq 1 ] || continue
				echo "omp-bot: dropped $# message(s) to unknown bot $to" >&2
				rm -f "$@"
				continue
			fi
			mkdir -p "$state/bots/$to/inbox/$name" && mv -f "$@" "$state/bots/$to/inbox/$name/" || true
		done
	done
}
[ -n "${boxed:-}" ] || "$root/bin/omp-bot-helper" reap || true
post &
mailer=$!
trap 'kill "$mailer" 2>/dev/null' EXIT
memory=$(field memory)
memory=${memory:-optchat}
export OMP_BOT_MEMORY="$memory"
case $memory in
optchat)
	[ -n "${OMP_BOT_OPTCHAT:-}" ] || { echo "omp-bot: $name keeps OptChat memory but OMP_BOT_OPTCHAT, OptChat's directory, is unset; set it, or \"memory\": \"none\" on the bot" >&2; exit 1; }
	mkdir -p "$dir/optchat"
	export OPTCHAT_DIR="$dir/optchat" OPTCHAT_BOT="$name" OPTCHAT_BOTS="$state/bots"
	set -- -e "$OMP_BOT_OPTCHAT/extension.ts" --config "$root/omp/memory.yml" "$@"
	"$root/bin/omp-bot-memory" "$name" >>"$dir/optchat/optchatd.log" 2>&1 &
	summariser=$!
	trap 'kill "$summariser" "$mailer" 2>/dev/null' EXIT
	;;
none) ;;
*) echo "omp-bot: $name has unknown memory '$memory' (optchat or none)" >&2; exit 1 ;;
esac
set -- -e "$root/omp/core.ts" -e "$root/omp/mail.ts" -e "$root/omp/cwd.ts" -e "$root/omp/done.ts" -e "$root/omp/supervise.ts" --config "$root/omp/demo.yml" --session-dir "$dir/sessions" "$@"
export OMP_BOT_RELAUNCH="$dir/relaunch.$$"
rm -f "$OMP_BOT_RELAUNCH"
starts=0
while :; do
	code=0
	[ "$memory" != optchat ] || flock -n -E 75 -o "$dir/lock" "$root/bin/omp-bot-trim" "$dir/sessions" || true
	session=$(ls -t "$dir/sessions"/*.jsonl 2>/dev/null | head -n 1) || session=
	started=$(date +%s)
	flock -n -E 75 -o "$dir/lock" "$omp" -e "$root/omp/omp-bot.ts" ${session:+--restore} ${session:+"$session"} "$@" || code=$?
	if [ "$code" = 75 ]; then
		echo "omp-bot: $name is already open somewhere else" >&2
		exit 75
	fi
	if [ -e "$OMP_BOT_RELAUNCH" ]; then
		rm -f "$OMP_BOT_RELAUNCH"
		exit 76
	fi
	[ "$code" != 0 ] || exit 0
	if [ $(($(date +%s) - started)) -lt 60 ]; then
		starts=$((starts + 1))
	else
		starts=1
	fi
	if [ -n "${boxed:-}" ] && ! why=$("$root/bin/omp-bot-health"); then
		echo "omp-bot: $name lost its box ($why); it carries on here once the box answers again…" >&2
		until "$root/bin/omp-bot-health" >/dev/null; do sleep 5; done
		continue
	fi
	case $starts in
	1) delay=2 ;;
	2) delay=4 ;;
	3) delay=8 ;;
	4) delay=16 ;;
	5) delay=30 ;;
	6) delay=60 ;;
	7) delay=120 ;;
	*) delay=300 ;;
	esac
	more=
	[ "$starts" -lt 2 ] || more=" ($starts starts in a row)"
	if [ -n "${boxed:-}" ] && [ "$code" = 255 ]; then
		why="exit 255, the box dropped its session"
	else
		why="exit $code"
	fi
	echo "omp-bot: $name ended ($why)$more; the same conversation resumes in ${delay}s" >&2
	sleep "$delay"
done
