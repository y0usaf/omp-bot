#!/bin/sh
set -eu
usage="usage: omp-bot NAME [--headless | --create TINT] [omp args...]"
[ $# -ge 1 ] || { echo "$usage" >&2; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
name=$1
shift
case $name in
"" | .* | *[!A-Za-z0-9._\ -]*) echo "omp-bot: invalid bot name '$name' (letters, digits, space, '.', '_' or '-', not starting with '.')" >&2; exit 2 ;;
esac
[ ${#name} -le 40 ] || { echo "omp-bot: bot name longer than 40 characters" >&2; exit 2; }
headless=0
tint=
case ${1:-} in
--headless) headless=1; shift ;;
--create) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; tint=$2; shift 2 ;;
esac
config=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/env
[ ! -r "$config" ] || . "$config"
state=${OMP_BOT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omp-bot}
mkdir -p "$state"
[ -e "$state/bots.json" ] || { cp "$root/bots.json" "$state/bots.json" && chmod 644 "$state/bots.json"; }
if [ -n "$tint" ]; then
	(
		flock 9
		jq -e --arg n "$name" 'any(.[]; .name == $n)' "$state/bots.json" >/dev/null && exit 0
		tmp=$(mktemp "$state/bots.json.XXXXXX")
		jq --arg n "$name" --arg t "$tint" '. + [{name: $n, role: "Assistant", tint: $t, cwd: "~"}]' "$state/bots.json" >"$tmp"
		chmod 644 "$tmp"
		mv -f "$tmp" "$state/bots.json"
	) 9>"$state/bots.lock"
fi
bot=$(jq -ce --arg n "$name" '.[] | select(.name == $n)' "$state/bots.json") || { echo "omp-bot: no bot named $name in $state/bots.json" >&2; exit 1; }
field() { printf '%s' "$bot" | jq -r --arg k "$1" '.[$k] // empty'; }
dir=$state/bots/$name
mkdir -p "$dir/sessions"
cwd=$(field cwd)
case $cwd in "~") cwd=$HOME ;; "~/"*) cwd=$HOME/${cwd#"~/"} ;; esac
cd "${cwd:-$HOME}"
export OMP_BOT_NAME="$name" OMP_BOT_ROLE="$(field role)" OMP_BOT_TINT="$(field tint)" OMP_BOT_STATE="$state" PI_NO_TITLE=1 PI_NOTIFICATIONS=off
persona=$(field persona)
[ -z "$persona" ] || export OMP_BOT_PERSONA="$persona"
set -- --continue "$@"
[ -z "${OMP_BOT_EXTENSION:-}" ] || set -- -e "$OMP_BOT_EXTENSION" "$@"
[ "${OMP_BOT_NO_TOOLS:-}" != 1 ] || set -- --no-tools "$@"
[ "$(field extensions)" = true ] || set -- --no-extensions "$@"
[ -z "${OMP_BOT_MODEL:-}" ] || set -- --model "$OMP_BOT_MODEL" "$@"
set -- -e "$root/omp/core.ts" --config "$root/omp/demo.yml" --session-dir "$dir/sessions" "$@"
if [ "$headless" = 1 ]; then
	export OMP_BOT_HEADLESS=1
	exec flock -n "$dir/lock" "${OMP_BIN:-omp}" --mode rpc --no-ui "$@"
fi
"$root/bin/omp-bot-ctl" claim "$name" || true
code=0
flock -w 30 -E 75 "$dir/lock" "${OMP_BIN:-omp}" -e "$root/omp/omp-bot.ts" "$@" || code=$?
[ "$code" != 75 ] || echo "omp-bot: $name is already open somewhere else" >&2
exit "$code"
