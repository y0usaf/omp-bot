#!/usr/bin/env bash
# Runs omp inside omp-box for a bot whose roster entry has "box": true; bin/omp-bot calls it in place of omp.
# The box gives each boxed bot a Unix user of its own (finix's omp-box/guest.nix), whose home holds only what the
# grants for that bot name: its own state folder, its persist paths and any folder finix gives it. Every path the
# bot knows is the same path relative to its guest home, so the bot sees its own files and nothing of the user's.
set -euo pipefail
root=$(cd -P "$(dirname "$0")/.." && pwd)
: "${OMP_BOT_NAME:?omp-bot-box runs from bin/omp-bot}" "${OMP_BOT_STATE:?omp-bot-box runs from bin/omp-bot}"
[ -n "${OMP_BOT_BOX_SSH_CONFIG:-}" ] || { echo "omp-bot-box: OMP_BOT_BOX_SSH_CONFIG, the ssh config that reaches the box, is unset (see box.env in the README)" >&2; exit 1; }
name=$OMP_BOT_NAME
state=$OMP_BOT_STATE
dir=$state/bots/$name
tag=$(printf '%s' "$name" | tr -cd 'A-Za-z0-9._-')
cache=$HOME/.cache/omp-bot/box
ssh=(ssh -F "$OMP_BOT_BOX_SSH_CONFIG")
why=$("$root/bin/omp-bot-health") || { echo "omp-bot-box: $name can't start because its box is down: $why" >&2; exit 1; }

# The guest user, and the home only it can read, come from finix; a bot the box has no user for refuses to start
# rather than landing in someone else's home.
[ -n "${OMP_BOT_BOX_USERS:-}" ] || {
	echo "omp-bot-box: OMP_BOT_BOX_USERS is unset, so the box's users are unknown (see box.env)" >&2
	exit 1
}
entry=$(jq -ce --arg n "$name" '.[$n]' <<<"$OMP_BOT_BOX_USERS" 2>/dev/null) || {
	echo "omp-bot-box: $name is not named in finix's list of box users, so it cannot run in the box" >&2
	exit 1
}
guest=$(jq -r '.user' <<<"$entry")
ghome=$(jq -r '.home' <<<"$entry")
folders=$(jq -r '.folders[]?' <<<"$entry")

# A host path as the same user sees it in the box: inside the user's home keeps its place under the box home.
map_path() {
	local p=$1
	case $p in
	"$HOME") printf '%s' "$ghome" ;;
	"$HOME"/*) printf '%s/%s' "$ghome" "${p#"$HOME"/}" ;;
	*) printf '%s' "$p" ;;
	esac
}

# Share the bot's folder, its persist paths and its folders into the box, where the grants place them in this
# bot's own home. A path the persist hook has just mounted is shared again, so the box sees the persisted folder
# instead of the one it replaced.
grants=$(omp-box list --json)
fresh=$'\n'${OMP_BOT_PERSIST_FRESH:-}$'\n'
grant() {
	local path=$1 want=$2 have try i=1
	mkdir -p "$path"
	have=$(jq -r --arg p "$path" --arg u "$guest" '[.[] | select(.path == $p and .user == $u) | .name][0] // empty' <<<"$grants")
	if [ -n "$have" ]; then
		case $fresh in *$'\n'"$path"$'\n'*) ;; *) return 0 ;; esac
		omp-box rm "$have" >/dev/null
		omp-box add "$path" --name "$have" --as "$guest" >/dev/null
	else
		try=$want
		while jq -e --arg n "$try" 'any(.[]; .name == $n)' <<<"$grants" >/dev/null; do
			i=$((i + 1))
			try=$want.$i
		done
		omp-box add "$path" --name "$try" --as "$guest" >/dev/null
	fi
	grants=$(omp-box list --json)
}
grant "$dir" "omp-bot.$tag"
i=0
while IFS= read -r path; do
	[ -n "$path" ] || continue
	i=$((i + 1))
	grant "$path" "omp-bot.$tag.$i"
done <<<"${OMP_BOT_PERSIST_PATHS:-}"
while IFS= read -r folder; do
	[ -n "$folder" ] || continue
	grant "$HOME/$folder" "omp-bot.$tag.work.$folder"
done <<<"$folders"

# The secrets shared with this bot reach it as a copy of the ones its roster entry allows, sealed with its own key.
if command -v omp-secret >/dev/null && ! omp-secret sync --bot "$name" >&2; then
	echo "omp-bot-box: could not copy $name's allowed shared secrets into its store; it reads only its own" >&2
fi

fwd=()
for k in $(compgen -e); do
	case $k in
	OMP_BOT_BOX_* | OMP_BOT_PERSIST*) ;;
	OMP_BOT_* | OPTCHAT_* | PI_* | TERM | TERM_PROGRAM | TERM_PROGRAM_VERSION | COLORTERM | LANG | LC_*) fwd+=("$k") ;;
	esac
done
declare -A tops=()
# A path through a link into the store, like an omp extension finix links under ~/.omp/agent/ext, stands for
# its store path, which the box can reach.
real() {
	local v=$1 r
	if [[ $v == /* && $v != /nix/store/* && -e $v ]] && r=$(readlink -f -- "$v") && [[ $r == /nix/store/* ]]; then v=$r; fi
	printf '%s' "$v"
}
scan() {
	local v t
	v=$(real "$1")
	if [[ $v == /nix/store/* ]]; then t=${v#/nix/store/}; tops[${t%%/*}]=1; fi
}
scan "$root"
for a in "$@"; do scan "$a"; done
for k in "${fwd[@]}"; do scan "${!k}"; done

# The box's root-run share service mounts each grant within a couple of seconds; give it room, then read which
# store paths the box lacks. A store path one of the links in OMP_BOT_BOX_EXT (finix's seed share: NAME -> a copy
# of a store path, the names the box's own omp config loads its extensions by) points at is named by that link, so
# the bot and the box name an extension alike and omp loads it once; one neither there nor in the box's store is
# copied.
prelude='set -euo pipefail
state=$1 dir=$2 cache=$3 root=$4 ext=$5
shift 5
mkdir -p "$state/bots" "$cache/store"
for _ in $(seq 120); do mountpoint -q "$dir" && break; sleep 0.5; done
mountpoint -q "$dir" || { echo "omp-bot-box: $dir is not shared into the box yet (omp-box list)" >&2; exit 1; }
case $root in /nix/store/*) ;; *) [ -e "$root" ] || { echo "omp-bot-box: $root is not in the box; share it with omp-box add" >&2; exit 1; } ;; esac
cat >"$state/bots.json.tmp"
mv -f "$state/bots.json.tmp" "$state/bots.json"
declare -A named=()
if [ -n "$ext" ]; then
	for link in "$ext"/*; do
		if [ -L "$link" ]; then named[$(basename "$(readlink "$link")")]=$link; fi
	done
fi
for t in "$@"; do
	if [ -n "${named[$t]:-}" ]; then echo "named $t ${named[$t]}"
	elif [ -e "/nix/store/$t" ]; then echo "store $t"
	elif [ ! -e "$cache/store/$t" ]; then echo "copy $t"
	fi
done'
declare -A instore=() named=()
missing=()
while read -r kind t link; do
	case $kind in store) instore[$t]=1 ;; named) named[$t]=$link ;; copy) missing+=("$t") ;; esac
done < <(jq -c --arg n "$name" 'map(if .name == $n then . else {name, tint, avatar} end)' "$state/bots.json" |
	"${ssh[@]}" -T -l "$guest" box "bash -c $(printf %q "$prelude") omp-bot-box $(printf '%q ' "$(map_path "$state")" "$(map_path "$dir")" "$(map_path "$cache")" "$root" "${OMP_BOT_BOX_EXT:-}")" "${!tops[@]}")
if [ ${#missing[@]} -gt 0 ]; then
	sync='set -euo pipefail
t=$(mktemp -d "$1/.in.XXXXXX")
tar -xf - -C "$t"
chmod -R u+w "$t"
for x in "$t"/*; do [ -e "$1/${x##*/}" ] || mv "$x" "$1/"; done
rm -rf "$t"'
	tar -C /nix/store -cf - "${missing[@]}" | "${ssh[@]}" -T -l "$guest" box "bash -c $(printf %q "$sync") omp-bot-box $(printf %q "$(map_path "$cache")")"
fi
map() {
	local v t top
	v=$(real "$1")
	if [[ $v == /nix/store/* ]]; then
		t=${v#/nix/store/}
		top=${t%%/*}
		if [ -n "${named[$top]:-}" ]; then v=${named[$top]}${t#"$top"}
		elif [ -z "${instore[$top]:-}" ]; then v=$(map_path "$cache")/store/$t
		fi
	fi
	printf '%s' "$v"
}

cwd=$(map_path "${OMP_BOT_BOX_CWD:-$HOME}")
tools=$(map "$root")/tools/$name/bin
# The box creates what the bot writes as the host user, and no mode the bot can set makes it the owner, so the bot
# writes with no umask of its own: everything it creates stays writable to it, inside folders only it can reach.
cmd="umask 000; { cd $(printf %q "$cwd") 2>/dev/null || { mkdir -p $(printf %q "$cwd") && cd $(printf %q "$cwd"); }; } && export PATH=$(printf %q "$tools:$(map "$root")/bin${OMP_BOT_BOX_PATH:+:$OMP_BOT_BOX_PATH}"):\"\$PATH\" && exec env"
for k in "${fwd[@]}"; do cmd+=" $(printf %q "$k=$(map_path "$(map "${!k}")")")"; done
# A boxed bot keeps its secrets in its own folder, which the box shares, encrypted with a key of its own there. The
# box presents the user's files as the user's, so git is told the folders the bot was granted are its own.
cmd+=" $(printf %q "OMP_SECRETS_DIR=$(map_path "$dir/secrets")") OMP_BOT_BOXED=1"
cmd+=" GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory $(printf %q "GIT_CONFIG_VALUE_0=*") omp"
# A path into the store, like an extension link, is named by the box first, and only what is left is a path inside
# the bot's own home that the box sees under its guest home.
for a in "$@"; do cmd+=" $(printf %q "$(map_path "$(map "$a")")")"; done
tty=-T
[ -t 0 ] && [ -t 1 ] && tty=-t
exec "${ssh[@]}" "$tty" -l "$guest" box "$cmd"
