#!/bin/sh
# Opens the task board in its own Tern window: its own config, daemon and Tern state, so the live
# session, its plugins and tabs are never touched; the board reads and answers the omp-botd queue
# OMP_BOT_STATE names. --headless serves it offscreen for shots (prints the control socket); --stop
# closes it.
set -eu
root=$(cd -P "$(dirname "$0")/.." && pwd)
xdg_state=${XDG_STATE_HOME:-$HOME/.local/state}
user_tern=${XDG_CONFIG_HOME:-$HOME/.config}/tern
state=$xdg_state/omp-bot-board
export OMP_BOT_STATE="${OMP_BOT_STATE:-$xdg_state/omp-bot}" OMP_BOT_ROOT="$root"
sock=$state/ctl.sock
export TERN_CONFIG_DIR="$state/config" TERN_DAEMON_SOCKET="$state/daemon.sock" TMPDIR="$state/tmp"
export XDG_STATE_HOME="$state/xdg/state" XDG_CACHE_HOME="$state/xdg/cache" XDG_DATA_HOME="$state/xdg/data"
ctl() { tern ctl --control "$sock" "$@" >/dev/null; }
opened() { tern ctl --control "$sock" state | jq -e '.tabs | any(.title == "Task board")' >/dev/null; }
wait_for() {
	tries=0
	until ctl $1 2>/dev/null && ${3:-true}; do
		tries=$((tries + 1))
		[ "$tries" -lt 100 ] || { echo "omp-bot-board: $2, see $state/tern.log" >&2; exit 1; }
		sleep 0.2
	done
}

case ${1:-} in
--stop)
	ctl quit 2>/dev/null || true
	# the daemon keeps running while a window is still attached
	tries=0
	while ctl state 2>/dev/null && [ "$tries" -lt 25 ]; do
		sleep 0.2
		tries=$((tries + 1))
	done
	sleep 0.5
	pkill -f "daemon --socket $TERN_DAEMON_SOCKET" || true
	rm -f "$sock"
	exit 0
	;;
--headless | "") ;;
*)
	echo "usage: omp-bot-board [--headless | --stop]" >&2
	exit 2
	;;
esac

mkdir -p "$TERN_CONFIG_DIR/plugins" "$TERN_CONFIG_DIR/themes" "$TMPDIR" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"
printf '%s\n' "$root/task-board" >"$TERN_CONFIG_DIR/plugins/task-board.path"
light=light dark=graphite
if [ -f "$user_tern/themes/ozette.css" ] && [ -d "$user_tern/plugins/ozette" ]; then
	cp "$user_tern"/themes/*.css "$TERN_CONFIG_DIR/themes/"
	rm -rf "$TERN_CONFIG_DIR/plugins/ozette"
	cp -r "$user_tern/plugins/ozette" "$TERN_CONFIG_DIR/plugins/ozette"
	light=ozette dark=ozette-night
fi
: >"$TERN_CONFIG_DIR/welcomed"
[ -e "$TERN_CONFIG_DIR/settings.json" ] ||
	printf '{"theme": "System", "theme_light": "%s", "theme_dark": "%s", "layout": "Rail", "material": "Solid", "status_bar": false, "pane_headers": "Never"}\n' "$light" "$dark" >"$TERN_CONFIG_DIR/settings.json"

if ! ctl state 2>/dev/null; then
	rm -f "$sock"
	if [ "${1:-}" = --headless ]; then
		fixtures=$state/fixtures/crates
		rm -rf "$fixtures"
		mkdir -p "$fixtures/tern" "$fixtures/plugins/fixtures"
		ln -sfn "$root/task-board" "$fixtures/plugins/fixtures/task-board"
		[ ! -d "$TERN_CONFIG_DIR/plugins/ozette" ] || ln -sfn "$TERN_CONFIG_DIR/plugins/ozette" "$fixtures/plugins/fixtures/ozette"
		STENCIL_FIXTURE_ROOT="$fixtures/tern" setsid -f tern serve --control "$sock" --out "$state/shots" >"$state/tern.log" 2>&1
	else
		setsid -f tern --control "$sock" >"$state/tern.log" 2>&1
	fi
	wait_for state "Tern did not start"
	[ "${1:-}" != --headless ] || ctl plugins fixtures
fi
opened || ctl plugins run plugin.task-board.open
wait_for state "the task board did not open" opened
echo "$sock"
