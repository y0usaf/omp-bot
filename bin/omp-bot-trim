#!/bin/sh
# omp-bot-trim SESSIONS_DIR
#
# Keeps a bot's newest session transcript small enough that omp can restore it
# without holding a whole conversation in memory. omp restores every entry of a
# session into JS objects (~5x the JSONL bytes) and keeps them for the process
# lifetime, while a bot's model context is the OptChat memory view plus the
# recent turns: the rest is only ever read from disk (zoom, history://) or from
# the memory. So the file is cut down to a header, the entries that decide the
# model, thinking level, rules and spend, and the last OMP_BOT_TRIM_BYTES of
# turns. The full transcript moves to SESSIONS_DIR/archive/. The session id,
# title and mtime stay, so nothing downstream (OptChat's per-session log,
# `ls -t`) changes.
set -eu
[ $# -eq 1 ] || { echo "usage: omp-bot-trim SESSIONS_DIR" >&2; exit 2; }
dir=$1
keep=${OMP_BOT_TRIM_BYTES:-8000000}
case $keep in '' | *[!0-9]*) echo "omp-bot-trim: OMP_BOT_TRIM_BYTES is not a byte count" >&2; exit 2 ;; esac
file=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1) || exit 0
[ -n "$file" ] && [ -f "$file" ] || exit 0
size=$(wc -c < "$file")
[ "$size" -gt $((keep * 2)) ] || exit 0

base=$(basename "$file")
rm -rf "$dir"/.trim.*
work=$(mktemp -d "$dir/.trim.XXXXXX") || exit 0
trap 'rm -rf "$work"' EXIT
trap 'rm -rf "$work"; exit 1' HUP INT TERM

head -n 1 "$file" > "$work/title"
grep -q '"pad"' "$work/title" || : > "$work/title"
sed -n 2p "$file" > "$work/header"
jq -e '.type == "session" and (.id | type) == "string"' "$work/header" > /dev/null || exit 0
sed -E ':p; s/(^|[^\\])((\\\\)*)\\u([dD][89abAB][0-9a-fA-F]{2})\\u([dD][c-fC-F][0-9a-fA-F]{2})/\1\2\x01\4\x01\5/; tp
	:l; s/(^|[^\\\x01])((\\\\)*)\\u[dD][89a-fA-F][0-9a-fA-F]{2}/\1\2\\ufffd/; tl
	s/\x01/\\u/g' "$file" > "$work/all"

tail -c "$keep" "$work/all" | sed '1d' | jq -c . > "$work/tail"
[ -s "$work/tail" ] || exit 0

jq -cR 'try (fromjson | select(.id) | [.id, (.parentId // ""), .type, (.role // "default")]) catch empty' "$work/all" > "$work/index"
jq -r 'select(.id) | .id' "$work/tail" > "$work/tailids"
awk -F '"' -v tailids="$work/tailids" -v suffix="$work/suffix" '
	BEGIN { while ((getline line < tailids) > 0) tail[line] = 1 }
	{ id = $2; parent[id] = $4; type[id] = $6; role[id] = $8; leaf = id }
	END {
		for (id = leaf; id != "" && !(id in seen); id = parent[id]) { seen[id] = 1; chain[++n] = id }
		for (i = 1; i <= n && (chain[i] in tail); i++) { live[chain[i]] = 1; print chain[i] > suffix }
		for (i = n; i >= 1; i--) {
			id = chain[i]
			if (id in live) continue
			t = type[id]
			if (t == "model_usage") keep[id] = 1
			else if (t == "thinking_level_change" || t == "service_tier_change" || t == "mode_change") last[t] = id
			else if (t == "model_change") last[t "\t" role[id]] = id
			else if (t == "ttsr_injection") { ttsr[++k] = id }
		}
		for (key in last) keep[last[key]] = 1
		for (i = k - 2; i <= k; i++) if (i >= 1) keep[ttsr[i]] = 1
		for (id in keep) print id
	}' "$work/index" | jq -R . | jq -s 'map({(.): true}) | add // {}' > "$work/keep"
jq -cR --slurpfile keep "$work/keep" 'try (fromjson | select(.id and $keep[0][.id])) catch empty' "$work/all" > "$work/carry"
jq -sc 'sort_by(.timestamp // "") | foreach .[] as $e ({p: null}; {p: $e.id, e: ($e + {parentId: .p})}; .e)' "$work/carry" > "$work/settings.jsonl"
root=$(tail -n 1 "$work/settings.jsonl" | jq -r '.id // ""')
[ -s "$work/suffix" ] || exit 0
jq -R . "$work/suffix" | jq -s 'map({(.): true}) | add' > "$work/live"
jq -c --slurpfile live "$work/live" 'select(.id and $live[0][.id])' "$work/tail" > "$work/active"

{
	[ ! -s "$work/title" ] || cat "$work/title"
	cat "$work/header"
	[ ! -s "$work/settings.jsonl" ] || cat "$work/settings.jsonl"
	head -n 1 "$work/active" | jq -c --arg p "$root" '.parentId = (if $p == "" then null else $p end)'
	tail -n +2 "$work/active"
} > "$work/new"

[ "$(grep -c '' "$work/new")" -gt 2 ] || exit 0
jq -e -c . "$work/new" > /dev/null || exit 0
mkdir -p "$dir/archive"
archive=$dir/archive/$base
[ ! -e "$archive" ] || archive=$dir/archive/"${base%.jsonl}.$(date +%s).jsonl"
ln "$file" "$archive"
touch -r "$file" "$work/new"
mv -f "$work/new" "$file"
