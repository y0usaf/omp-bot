#!/bin/sh
# Tern's "Secrets: Add" runs this in a tab of its own: an omp session that shows only the secrets extension's masked
# box, stores NAME for BOT (or, with no BOT, shared with every bot), never expiring, and ends when the box closes.
set -eu
[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: omp-bot-secret NAME [BOT]" >&2; exit 2; }
config=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/env
[ ! -r "$config" ] || . "$config"
[ -n "${OMP_BOT_SECRETS_EXTENSION:-}" ] || { echo "omp-bot-secret: OMP_BOT_SECRETS_EXTENSION, the secrets extension, is unset" >&2; exit 1; }
export OMP_SECRET_ADD="$1" OMP_SECRET_FOR="${2:-}" PI_NO_TITLE=1 PI_NOTIFICATIONS=off
unset OMP_BOT_NAME OMP_SECRETS_DIR
cd "$HOME"
exec "${OMP_BIN:-omp}" --no-session --no-extensions --no-tools --no-skills --no-rules --no-lsp --no-title -e "$OMP_BOT_SECRETS_EXTENSION"
