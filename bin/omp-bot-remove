#!/bin/sh
set -eu
[ $# -eq 1 ] || { echo "usage: omp-bot-remove NAME" >&2; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
name=$1
config=${XDG_CONFIG_HOME:-$HOME/.config}/omp-bot/env
[ ! -r "$config" ] || . "$config"
state=${OMP_BOT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omp-bot}
export OMP_BOT_STATE="$state"
[ -e "$state/bots.json" ] || { echo "omp-bot-remove: no roster at $state/bots.json" >&2; exit 1; }
jq -e --arg n "$name" 'any(.[]; .name == $n)' "$state/bots.json" >/dev/null || { echo "omp-bot-remove: no bot named $name" >&2; exit 1; }
"$root/bin/omp-bot-ctl" retire "$name"
dir=$state/bots/$name
if [ -d "$dir" ]; then
	if ! flock -w 15 "$dir/lock" true; then
		"$root/bin/omp-bot-ctl" unretire "$name" 2>/dev/null || true
		echo "omp-bot-remove: $name is still running; close its tab first" >&2
		exit 75
	fi
fi
(
	flock 9
	tmp=$(mktemp "$state/bots.json.XXXXXX")
	jq --arg n "$name" 'map(select(.name != $n))' "$state/bots.json" >"$tmp"
	chmod 644 "$tmp"
	mv -f "$tmp" "$state/bots.json"
) 9>"$state/bots.lock"
if [ -d "$dir" ]; then
	mkdir -p "$state/archive"
	mv "$dir" "$state/archive/$name-$(date +%Y%m%d-%H%M%S)"
fi
"$root/bin/omp-bot-ctl" unretire "$name" 2>/dev/null || true
echo "removed $name"
